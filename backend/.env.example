# Copy to .env for local dev. On Render, set these in the dashboard instead.
GEMINI_API_KEY=
OPENWEATHER_API_KEY=
DATA_GOV_API_KEY=

GEMINI_MODEL=gemini-3.5-flash-lite
# Your Netlify URL (visiting the backend home page redirects here), e.g. https://your-site.netlify.app
FRONTEND_URL=
RATE_LIMIT_PER_MINUTE=20

# Accounts + saved chats. Leave EMPTY locally (uses a SQLite file). In production paste a hosted Postgres URL
# (free: neon.tech or supabase.com), e.g. postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=

# Optional: model used for the YES/NO "is this a farming question?" check (defaults to GEMINI_MODEL)
GUARD_MODEL=

# Optional: how much the model 'thinks' before answering. LOW = fastest (default). MEDIUM / HIGH / DEFAULT = slower, deeper.
THINKING_LEVEL=LOW
